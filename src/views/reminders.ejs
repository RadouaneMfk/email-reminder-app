<div class="container py-5">

  <!-- Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
    <h2 class="fw-bold mb-0">
      <i class="bi bi-envelope-check me-2"></i>All Reminders
    </h2>

    <div class="d-flex gap-2">
      <a href="/schedule" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Schedule
      </a>

      <a href="/dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Dashboard
      </a>
    </div>
  </div>

  <!-- Table -->
  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white shadow-sm rounded overflow-hidden">
      <thead class="table-primary">
        <tr>
          <th>Email</th>
          <th class="d-none d-sm-table-cell">Message</th>
          <th class="d-none d-sm-table-cell">Scheduled</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>

      <tbody>
        <% if (reminders.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center py-5 text-muted">
              <i class="bi bi-inbox fs-1 d-block mb-2"></i>
              No reminders found
            </td>
          </tr>
        <% } else { %>
          <% reminders.forEach(reminder => { %>
            <tr class="<%= reminder.sent ? 'opacity-75' : '' %>">

              <!-- Email + Mobile Details -->
              <td>
                <div class="fw-semibold"><%= reminder.email %></div>

                <!-- Mobile-only message & date -->
                <div class="d-sm-none text-muted small mt-2">
                  <div>
                    <i class="bi bi-chat-text me-1"></i>
                    <%= reminder.message %>
                  </div>
                  <div class="mt-1">
                    <i class="bi bi-calendar-event me-1"></i>
                    <%= new Date(reminder.scheduledTime).toLocaleString() %>
                  </div>
                </div>
              </td>

              <!-- Desktop Message -->
              <td class="d-none d-sm-table-cell text-truncate" style="max-width: 260px;">
                <%= reminder.message %>
              </td>

              <!-- Desktop Date -->
              <td class="d-none d-sm-table-cell">
                <%= new Date(reminder.scheduledTime).toLocaleString() %>
              </td>

              <!-- Status -->
              <td>
                <span class="badge rounded-pill <%= reminder.sent ? 'bg-success' : 'bg-warning text-dark' %>">
                  <i class="bi <%= reminder.sent ? 'bi-check-circle-fill' : 'bi-clock' %> me-1"></i>
                  <%= reminder.sent ? 'Sent' : 'Pending' %>
                </span>
              </td>

              <!-- Actions -->
              <td>
                <% if (!reminder.sent) { %>
                  <a
                    href="/reminders/edit/<%= reminder._id %>"
                    class="btn btn-sm btn-outline-primary me-2"
                  >
                    <i class="bi bi-pencil"></i>
                  </a>

                  <form
                    action="/reminders/delete/<%= reminder._id %>"
                    method="POST"
                    class="d-inline"
                    onsubmit="return confirm('Delete this reminder?');"
                  >
                    <button class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-muted small">
                    <i class="bi bi-lock-fill me-1"></i>Locked
                  </span>
                <% } %>
              </td>

            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
