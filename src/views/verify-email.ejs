<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Verify Email</title>

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    .auth-section {
      background: var(--gradient);
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      color: white;
    }

    .auth-section::before {
      content: "";
      position: absolute;
      inset: 0;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.1)" /></svg>') repeat;
      opacity: 0.1;
    }

    .auth-card {
      background: white;
      color: #333;
      border-radius: 20px;
      padding: 3rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      position: relative;
      z-index: 1;
      text-align: center;
    }

    .auth-title {
      font-size: 2.4rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      color: var(--primary-color);
    }

    .auth-subtitle {
      font-size: 1.05rem;
      opacity: 0.8;
      margin-bottom: 2rem;
    }

    .form-control {
      padding: 0.9rem 1rem;
      border-radius: 12px;
      font-size: 1.3rem;
      letter-spacing: 0.4rem;
      text-align: center;
    }

    .auth-btn {
      width: 100%;
      padding: 0.9rem;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 50px;
      background: var(--gradient);
      border: none;
      color: white;
      transition: all 0.3s ease;
      margin-top: 1.5rem;
    }

    .auth-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    .auth-icons {
      margin-bottom: 1.5rem;
    }

    .auth-icon {
      font-size: 4rem;
      color: var(--primary-color);
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
      100% { transform: translateY(0); }
    }

    .resend {
      margin-top: 1.5rem;
      font-size: 0.95rem;
    }

    .resend button {
      background: none;
      border: none;
      padding: 0;
      color: var(--primary-color);
      font-weight: 600;
      cursor: pointer;
    }

    .resend button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .alert {
      padding: 0.75rem 1rem;
      border-radius: 10px;
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }

    .alert-danger {
      background: #ffe5e5;
      color: #b30000;
    }

    .alert-success {
      background: #e6ffed;
      color: #1a7f37;
    }
  </style>
</head>
<body>

<section class="auth-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-5">
        <div class="auth-card">

          <div class="auth-icons">
            <i class="bi bi-envelope-check auth-icon"></i>
          </div>

          <h1 class="auth-title">Verify Your Email To Access The App</h1>
          <p class="auth-subtitle">
            We sent a 6-digit code to your email address "<%= email %>".<br>
            Please enter it below to continue.
          </p>

          <% if (typeof error !== "undefined") { %>
            <div class="alert alert-danger">
              <%= error %>
            </div>
          <% } %>

          <% if (typeof success !== "undefined") { %>
            <div class="alert alert-success">
              <%= success %>
            </div>
          <% } %>

          <form action="/verify-email" method="POST">
            <input
              type="text"
              name="code"
              class="form-control"
              placeholder="123456"
              maxlength="6"
              required
            />
            <button type="submit" class="auth-btn">
              <i class="bi bi-shield-check me-2"></i>
              Verify Email
            </button>
          </form>

          <div class="resend">
            Didn’t receive the code?
            <form action="/resend-verification" method="POST" id="resendForm" style="display:inline;">
              <button type="submit" id="resendBtn">Resend</button>
              <span id="timer" style="display:none; margin-left:8px;"></span>
            </form>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const resendBtn = document.getElementById("resendBtn");
  const timerText = document.getElementById("timer");

  const COOLDOWN_SECONDS = 60;
  const STORAGE_KEY = "otpResendCooldownEnd";

  let interval;

  function startTimer(remaining) {
    resendBtn.disabled = true;
    timerText.style.display = "inline";
    timerText.textContent = `(${remaining}s)`;

    interval = setInterval(() => {
      remaining--;
      timerText.textContent = `(${remaining}s)`;

      if (remaining <= 0) {
        clearInterval(interval);
        resendBtn.disabled = false;
        timerText.style.display = "none";
        localStorage.removeItem(STORAGE_KEY);
      }
    }, 1000);
  }

  // When resend is clicked, store cooldown end time
  resendBtn?.addEventListener("click", () => {
    const cooldownEnd = Date.now() + COOLDOWN_SECONDS * 1000;
    localStorage.setItem(STORAGE_KEY, cooldownEnd);
  });

  // On page load, check if cooldown still active
  window.addEventListener("load", () => {
    const cooldownEnd = localStorage.getItem(STORAGE_KEY);

    if (cooldownEnd) {
      const remaining = Math.floor((cooldownEnd - Date.now()) / 1000);
      if (remaining > 0) {
        startTimer(remaining);
      } else {
        localStorage.removeItem(STORAGE_KEY);
      }
    }
  });
</script>


</body>
</html>
