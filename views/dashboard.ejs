<style>
	.dashboard-hero {
	  background: var(--gradient);
	  padding: 80px 0;
	  color: white;
	  position: relative;
	  overflow: hidden;
	}
  
	.dashboard-hero::before {
	  content: "";
	  position: absolute;
	  inset: 0;
	  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.1)" /></svg>')
		repeat;
	  opacity: 0.1;
	}
  
	.dashboard-title {
	  font-size: 3rem;
	  font-weight: 800;
	}
  
	.dashboard-subtitle {
	  font-size: 1.2rem;
	  opacity: 0.9;
	  margin-top: 0.5rem;
	}
  
	.dashboard-content {
	  padding: 80px 0;
	  background: #f8f9fa;
	}
  
	.dashboard-card {
	  background: white;
	  border-radius: 20px;
	  padding: 2.5rem;
	  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
	  transition: all 0.3s ease;
	  text-align: center;
	  height: 100%;
	}
  
	.dashboard-card:hover {
	  transform: translateY(-8px);
	  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
	}
  
	.dashboard-icon {
	  font-size: 3.5rem;
	  color: var(--primary-color);
	  margin-bottom: 1.5rem;
	}
  
	.dashboard-card h3 {
	  font-size: 1.8rem;
	  font-weight: 700;
	  margin-bottom: 1rem;
	}
  
	.dashboard-card p {
	  opacity: 0.8;
	  margin-bottom: 2rem;
	}
  
	.dashboard-btn {
	  padding: 0.75rem 2rem;
	  font-size: 1.1rem;
	  font-weight: 600;
	  border-radius: 50px;
	  background: var(--gradient);
	  color: white;
	  border: none;
	  text-decoration: none;
	  display: inline-flex;
	  align-items: center;
	  gap: 0.5rem;
	  transition: all 0.3s ease;
	}
  
	.dashboard-btn:hover {
	  color: white;
	  transform: translateY(-2px);
	  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
	}
  </style>
  
  <!-- Dashboard Hero -->
  <section class="dashboard-hero">
	<div class="container text-center position-relative">
	  <h1 class="dashboard-title">
		Welcome, <%= user.name %> 👋
	  </h1>
	  <p class="dashboard-subtitle">
		Manage your email reminders in one place
	  </p>
	</div>
  </section>
  
  <!-- Dashboard Content -->
  <section class="dashboard-content">
	<div class="container">
	  <div class="row g-4 justify-content-center">
  
		<!-- My Reminders -->
		<div class="col-md-6 col-lg-5">
		  <div class="dashboard-card">
			<i class="bi bi-bell-fill dashboard-icon"></i>
			<h3>My Reminders</h3>
			<p>
			  View, edit, or delete your scheduled email reminders.
			</p>
			<a href="/reminders" class="dashboard-btn">
			  <i class="bi bi-list-check"></i>
			  View Reminders
			</a>
		  </div>
		</div>
  
		<!-- Schedule Reminder -->
		<div class="col-md-6 col-lg-5">
		  <div class="dashboard-card">
			<i class="bi bi-calendar-plus dashboard-icon"></i>
			<h3>Schedule Reminder</h3>
			<p>
			  Create a new reminder and never forget an important email.
			</p>
			<a href="/schedule" class="dashboard-btn">
			  <i class="bi bi-plus-circle"></i>
			  Schedule Now
			</a>
		  </div>
		</div>
  
	  </div>
	</div>
  </section>
  