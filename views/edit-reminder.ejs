<style>
    .schedule-section {
      padding: 100px 0;
    }
  
    .schedule-card {
      background: white;
      border-radius: 20px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      padding: 2rem;
      max-width: 600px;
      margin: 0 auto;
    }
  
    .schedule-header {
      text-align: center;
      margin-bottom: 2rem;
    }
  
    .schedule-header h1 {
      color: var(--primary-color);
      font-weight: 700;
      margin-bottom: 1rem;
    }
  
    .schedule-header p {
      color: #6c757d;
      font-size: 1.1rem;
    }
  
    .back-link {
      color: var(--primary-color);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      margin-bottom: 1rem;
    }
  
    .back-link:hover {
      color: var(--secondary-color);
    }
  </style>
  
  <!-- Edit Reminder Section -->
  <section class="schedule-section">
    <div class="container">
      <div class="schedule-card">
        <a href="/reminders" class="back-link">
          <i class="bi bi-arrow-left me-2"></i>Back to Reminders
        </a>
  
        <div class="schedule-header">
          <h1>Edit Your Reminder</h1>
          <p>Update the details below and save your changes</p>
        </div>
  
        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger d-flex align-items-center" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <div><%= error.msg %></div>
        </div>
        <% } %>
  
        <!-- Edit Form -->
        <form action="/reminders/edit/<%= reminder._id %>" method="POST">
          <!-- Email -->
          <div class="mb-4">
            <label for="email" class="form-label">Email Address</label>
            <input
              type="email"
              class="form-control"
              value="<%= reminder.email %>"
              disabled
            />
          </div>
  
          <!-- Message -->
          <div class="mb-4">
            <label for="message" class="form-label">Reminder Message</label>
            <textarea
              class="form-control"
              id="message"
              name="message"
              rows="4"
              required
            ><%= reminder.message %></textarea>
          </div>
  
          <!-- Date & Time -->
          <div class="mb-4">
            <label for="datetime" class="form-label">Date and Time</label>
            <input
              type="datetime-local"
              class="form-control"
              id="datetime"
              name="datetime"
              value="<%= reminder.scheduledTime.toISOString().slice(0,16) %>"
              required
            />
          </div>
  
          <!-- Buttons -->
          <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-circle me-2"></i>Update Reminder
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
  