<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login</title>

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    .auth-section {
      background: var(--gradient);
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      color: white;
    }

    .auth-section::before {
      content: "";
      position: absolute;
      inset: 0;
      background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.1)" /></svg>')
        repeat;
      opacity: 0.1;
    }

    .auth-card {
      background: white;
      color: #333;
      border-radius: 20px;
      padding: 3rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
      position: relative;
      z-index: 1;
    }

    .auth-title {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      color: var(--primary-color);
    }

    .auth-subtitle {
      font-size: 1.1rem;
      opacity: 0.8;
      margin-bottom: 2rem;
    }

    .form-control {
      padding: 0.9rem 1rem;
      border-radius: 12px;
    }

    .auth-btn {
      width: 100%;
      padding: 0.9rem;
      font-size: 1.1rem;
      font-weight: 600;
      border-radius: 50px;
      background: var(--gradient);
      border: none;
      color: white;
      transition: all 0.3s ease;
    }

    .auth-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    }

    /* ===== Google Button ===== */
    .google-btn {
      width: 100%;
      padding: 0.9rem;
      border-radius: 50px;
      border: 1px solid #ddd;
      background: #fff;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: all 0.3s ease;
      text-decoration: none;
      color: #444;
    }

    .google-btn:hover {
      background: #f8f9fa;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .google-icon {
      font-size: 1.0rem;
      color: #444444;
    }

    /* Divider */
    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 1.5rem 0;
      color: #888;
      font-size: 0.9rem;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      border-bottom: 1px solid #ddd;
    }

    .divider:not(:empty)::before {
      margin-right: .75em;
    }

    .divider:not(:empty)::after {
      margin-left: .75em;
    }

    .auth-footer {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.95rem;
    }

    .auth-footer a {
      color: var(--primary-color);
      font-weight: 600;
      text-decoration: none;
    }

    .auth-icons {
      text-align: center;
      margin-bottom: 2rem;
    }

    .auth-icon {
      font-size: 4rem;
      color: var(--primary-color);
      animation: float 3s ease-in-out infinite;
    }

    @keyframes float {
      0% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
      100% { transform: translateY(0); }
    }

    .password-wrapper {
      position: relative;
    }

    .toggle-password {
      position: absolute;
      top: 50%;
      right: 15px;
      transform: translateY(-50%);
      cursor: pointer;
      color: #888;
      font-size: 1.2rem;
    }
  </style>
</head>
<body>

<section class="auth-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-5">
        <div class="auth-card">

          <div class="auth-icons">
            <i class="bi bi-person-circle auth-icon"></i>
          </div>

          <h1 class="auth-title text-center">Welcome Back</h1>
          <p class="auth-subtitle text-center">
            Log in to manage your email reminders
          </p>

          <!-- Errors -->
          <% if (typeof errors !== "undefined" && errors.length > 0) { %>
            <div class="alert alert-danger">
              <ul class="mb-0">
                <% errors.forEach(function(err) { %>
                  <li><%= err.msg %></li>
                <% }); %>
              </ul>
            </div>
          <% } %>

          <!-- Google Login -->
          <a href="/auth/google" class="google-btn">
            <i class="bi bi-google google-icon"></i>
            Continue with Google
          </a>

          <div class="divider">OR</div>

          <!-- Email Login -->
          <form action="/login" method="POST">

            <div class="mb-3">
              <label class="form-label">Email address</label>
              <input
                type="email"
                name="email"
                class="form-control"
                placeholder="you@example.com"
                required
              />
            </div>

            <div class="mb-4 password-wrapper">
              <label class="form-label">Password</label>
              <input
                type="password"
                name="password"
                id="loginPassword"
                class="form-control"
                placeholder="••••••••"
                required
              />
              <i class="bi bi-eye toggle-password" data-target="loginPassword"></i>
            </div>

            <button type="submit" class="auth-btn">
              <i class="bi bi-box-arrow-in-right me-2"></i>
              Log In
            </button>

          </form>

          <div class="auth-footer">
            Don’t have an account?
            <a href="/register">Register</a>
          </div>

          <div class="auth-footer">
            <a href="/forgot-password">Forgot password?</a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll(".toggle-password").forEach(icon => {
    icon.addEventListener("click", () => {
      const input = document.getElementById(icon.dataset.target);
      const isPassword = input.type === "password";

      input.type = isPassword ? "text" : "password";
      icon.classList.toggle("bi-eye");
      icon.classList.toggle("bi-eye-slash");
    });
  });
</script>

</body>
</html>
