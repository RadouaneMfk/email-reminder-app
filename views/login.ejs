<style>
	.auth-section {
	  background: var(--gradient);
	  min-height: 100vh;
	  display: flex;
	  align-items: center;
	  position: relative;
	  overflow: hidden;
	  color: white;
	}
  
	.auth-section::before {
	  content: "";
	  position: absolute;
	  inset: 0;
	  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="40" fill="rgba(255,255,255,0.1)" /></svg>')
		repeat;
	  opacity: 0.1;
	}
  
	.auth-card {
	  background: white;
	  color: #333;
	  border-radius: 20px;
	  padding: 3rem;
	  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
	  position: relative;
	  z-index: 1;
	}
  
	.auth-title {
	  font-size: 2.5rem;
	  font-weight: 800;
	  margin-bottom: 0.5rem;
	  color: var(--primary-color);
	}
  
	.auth-subtitle {
	  font-size: 1.1rem;
	  opacity: 0.8;
	  margin-bottom: 2rem;
	}
  
	.form-control {
	  padding: 0.9rem 1rem;
	  border-radius: 12px;
	}
  
	.auth-btn {
	  width: 100%;
	  padding: 0.9rem;
	  font-size: 1.1rem;
	  font-weight: 600;
	  border-radius: 50px;
	  background: var(--gradient);
	  border: none;
	  color: white;
	  transition: all 0.3s ease;
	}
  
	.auth-btn:hover {
	  transform: translateY(-2px);
	  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
	}
  
	.auth-footer {
	  margin-top: 1.5rem;
	  text-align: center;
	  font-size: 0.95rem;
	}
  
	.auth-footer a {
	  color: var(--primary-color);
	  font-weight: 600;
	  text-decoration: none;
	}
  
	.auth-icons {
	  text-align: center;
	  margin-bottom: 2rem;
	}
  
	.auth-icon {
	  font-size: 4rem;
	  color: var(--primary-color);
	  animation: float 3s ease-in-out infinite;
	}
  
	@keyframes float {
	  0% { transform: translateY(0); }
	  50% { transform: translateY(-10px); }
	  100% { transform: translateY(0); }
	}
  </style>
  
  <section class="auth-section">
	<div class="container">
	  <div class="row justify-content-center">
		<div class="col-md-8 col-lg-5">
		  <div class="auth-card">
			<div class="auth-icons">
			  <i class="bi bi-person-circle auth-icon"></i>
			</div>
  
			<h1 class="auth-title text-center">Welcome Back</h1>
			<p class="auth-subtitle text-center">
			  Log in to manage your email reminders
			</p>
  
			<% if (typeof error !== "undefined") { %>
			  <div class="alert alert-danger text-center">
				<%= error %>
			  </div>
			<% } %>
  
			<form action="/login" method="POST">
			  <div class="mb-3">
				<label class="form-label">Email address</label>
				<input
				  type="email"
				  name="email"
				  class="form-control"
				  placeholder="you@example.com"
				  required
				/>
			  </div>
  
			  <div class="mb-4">
				<label class="form-label">Password</label>
				<input
				  type="password"
				  name="password"
				  class="form-control"
				  placeholder="••••••••"
				  required
				/>
			  </div>
  
			  <button type="submit" class="auth-btn">
				<i class="bi bi-box-arrow-in-right me-2"></i>Log In
			  </button>
			</form>
  
			<div class="auth-footer">
			  Don’t have an account?
			  <a href="/register">Create one</a>
			</div>
		  </div>
		</div>
	  </div>
	</div>
  </section>
  